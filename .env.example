# =============================================================================
# T7 Faza E — secrets za mcp-gateway i ai-assistant-service (docker-compose)
# =============================================================================
# Kopiraj ovaj fajl u `.env` (koji je gitignored) i popuni pravim vrednostima:
#     cp .env.example .env
# Docker Compose automatski učitava `.env` iz istog direktorijuma i zamenjuje
# ${VAR} reference u docker-compose.yml. NIKAD ne commit-uj `.env` — samo ovaj
# `.env.example` šablon (sa praznim/placeholder vrednostima) ide u git.
# =============================================================================

# --- Anthropic API ključ (AiAssistantService — Claude demo agent) ------------
# Realan, plaćeni ključ sa https://console.anthropic.com/ . Model: claude-sonnet-5.
# Mapira se na env `Anthropic__ApiKey` u ai-assistant-service kontejneru.
ANTHROPIC_API_KEY=

# --- Agentov privatni RSA ključ, PEM (AiAssistantService) ---------------------
# Njime AiAssistantService potpisuje agent-JWT (RS256) kojim se predstavlja gatewayu.
# Javni parnjak je već u McpGateway/appsettings.json (Gateway:Agents[0].PublicKeyPem)
# i mora odgovarati OVOM privatnom ključu.
# Zapiši ga kao JEDNU liniju sa \n escape sekvencama (kod ih normalizuje u prave
# newline-ove pre ImportFromPem), npr:
#   AGENT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
# Mapira se na env `Agent__PrivateKeyPem` u ai-assistant-service kontejneru.
AGENT_PRIVATE_KEY_PEM=

# --- Lozinka za SELECT-only SQL nalog `mcp_read` (McpGateway read alati) -------
# Ista vrednost se koristi na DVA mesta:
#   (1) ReadDb__* connection stringovi mcp-gateway servisa (docker-compose.yml),
#   (2) umesto CHANGE_ME_IN_ENV pri pokretanju McpGateway/Sql/02_read_login.sql
#       (vidi McpGateway/Sql/README.md za bootstrap korak).
# SQL Server CHECK_POLICY=ON zahteva jaku lozinku (>=8 karaktera, mešavina
# velikih/malih slova + cifra/simbol).
MCP_READ_PASSWORD=
